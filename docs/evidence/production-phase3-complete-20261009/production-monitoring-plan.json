      "id": "/subscriptions/384c0376-d023-4a61-9dce-69ff8cbdcd0c/resourceGroups/dermaire-rg/providers/Microsoft.Insights/scheduledQueryRules/dermaire-production-ready",
      "location": "canadacentral",
      "properties": {
        "displayName": "Dermaire production ready",
        "description": "Production-scoped privacy-safe operational signal",
        "enabled": true,
        "severity": 2,
        "evaluationFrequency": "PT1M",
        "windowSize": "PT5M",
        "scopes": [
          "/subscriptions/384c0376-d023-4a61-9dce-69ff8cbdcd0c/resourceGroups/dermaire-rg/providers/Microsoft.OperationalInsights/workspaces/dermaire-production-logs"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AppServiceConsoleLogs | where _ResourceId =~ \"/subscriptions/384c0376-d023-4a61-9dce-69ff8cbdcd0c/resourceGroups/dermaire-rg/providers/Microsoft.Web/sites/dermaire-api\" | extend p=parse_json(ResultDescription) | where p.event == \"http_request\" and p.route == \"/health/ready\" and toint(p.status)>=500 | summarize value=count()",
              "timeAggregation": "Maximum",
              "metricMeasureColumn": "value",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "autoMitigate": true,
        "actions": {
          "actionGroups": [
